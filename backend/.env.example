# Copy this file to .env and add the MongoDB Atlas connection string from your project.
MONGO_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/phone_bandhu?retryWrites=true&w=majority
PORT=5200
NODE_ENV=development
# In production, set this to a random value of at least 32 bytes and keep it private.
SESSION_SECRET=
# Set the storefront's exact browser origin(s), comma separated, for production.
APP_ORIGINS=
PUBLIC_APP_URL=http://localhost:5200
# Admin access stays locked until both values are configured.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
# Configure real SMTP app credentials before enabling password recovery.
EMAIL_USER=
EMAIL_PASS=
