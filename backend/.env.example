# Copy this file to .env and add the MongoDB Atlas connection string from your project.
MONGO_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/phone_bandhu?retryWrites=true&w=majority
PORT=5200
ADMIN_EMAIL=master@example.com
ADMIN_PASSWORD_HASH=<bcrypt-hash-from-npm-run-admin-hash>
SESSION_SECRET=<random-secret-at-least-32-bytes>
